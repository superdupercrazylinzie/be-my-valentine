<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Will You Be My Valentine?</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Courier New', monospace;
        }
        
        body {
            background: #000;
            color: #00ff00;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        
        .container {
            background: #001a00;
            border: 3px solid #00ff00;
            padding: 40px;
            max-width: 600px;
            width: 100%;
            text-align: center;
            box-shadow: 0 0 30px rgba(0, 255, 0, 0.3);
            position: relative;
            overflow: hidden;
        }
        
        .scan-line {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: #00ff00;
            animation: scan 3s linear infinite;
            opacity: 0.5;
        }
        
        @keyframes scan {
            0% { top: 0; }
            100% { top: 100%; }
        }
        
        h1 {
            color: #00ff00;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 3px;
        }
        
        .message {
            background: #002200;
            border-left: 5px solid #00ff00;
            padding: 20px;
            margin: 30px 0;
            text-align: left;
            line-height: 1.6;
        }
        
        .buttons {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin: 40px 0;
            flex-wrap: wrap;
        }
        
        button {
            padding: 15px 40px;
            font-size: 1.2rem;
            border: 2px solid #00ff00;
            background: #003300;
            color: #00ff00;
            cursor: pointer;
            transition: all 0.3s;
            min-width: 180px;
        }
        
        button:hover {
            background: #00ff00;
            color: #000;
        }
        
        #no-btn {
            border-color: #ff3333;
            color: #ff3333;
            background: #330000;
        }
        
        #no-btn:hover {
            background: #ff3333;
            color: #000;
        }
        
        .result {
            display: none;
            margin-top: 30px;
            padding: 30px;
            background: #002200;
            border: 2px solid #00ff00;
        }
        
        .back-btn {
            margin-top: 20px;
            padding: 10px 30px;
            background: #004400;
            border: 1px solid #00ff00;
            color: #00ff00;
            cursor: pointer;
        }
        
        .footer {
            margin-top: 30px;
            font-size: 0.9rem;
            color: #009900;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="scan-line"></div>
        
        <h1>WILL YOU BE MY VALENTINE?</h1>
        
        <div class="message">
            <p>> Dear love,</p>
            <p>> I'm happy I found you.</p>
            <p>> Thanks for tolerating me.</p>
            <p>> Answer correctly or else.</p>
        </div>
        
        <div class="buttons" id="buttons">
            <button id="yes-btn">YES ✅</button>
            <button id="no-btn">NO ❌</button>
        </div>
        
        <div class="result" id="yes-result">
            <h2>CORRECT ANSWER!</h2>
            <p>> I'm glad you did that okay lol</p>
            <p>> See you soon</p>
            <p>> Love you or whatever</p>
            <button class="back-btn" onclick="resetPage()">BACK</button>
        </div>
        
        <div class="result" id="no-result">
            <h2>WRONG ANSWER!</h2>
            <p>> Bruh. Really?</p>
            <p>> That's not correct</p>
            <p>> Please reconsider</p>
            <button class="back-btn" onclick="resetPage()">TRY AGAIN</button>
        </div>
        
        <div class="footer">
            Fallout Theme | Choose Wisely
        </div>
    </div>

    <script>
        // Get elements
        const yesBtn = document.getElementById('yes-btn');
        const noBtn = document.getElementById('no-btn');
        const buttons = document.getElementById('buttons');
        const yesResult = document.getElementById('yes-result');
        const noResult = document.getElementById('no-result');
        
        // Yes button
        yesBtn.addEventListener('click', function() {
            buttons.style.display = 'none';
            yesResult.style.display = 'block';
        });
        
        // No button
        let noClicks = 0;
        noBtn.addEventListener('click', function() {
            noClicks++;
            
            if (noClicks < 3) {
                // Move button
                const maxX = window.innerWidth - 200;
                const maxY = window.innerHeight - 100;
                const x = Math.random() * maxX;
                const y = Math.random() * maxY;
                
                noBtn.style.position = 'fixed';
                noBtn.style.left = x + 'px';
                noBtn.style.top = y + 'px';
            } else {
                buttons.style.display = 'none';
                noResult.style.display = 'block';
            }
        });
        
        // Reset function
        function resetPage() {
            buttons.style.display = 'flex';
            yesResult.style.display = 'none';
            noResult.style.display = 'none';
            
            // Reset no button
            noBtn.style.position = '';
            noBtn.style.left = '';
            noBtn.style.top = '';
            noClicks = 0;
        }
    </script>
</body>
</html>
